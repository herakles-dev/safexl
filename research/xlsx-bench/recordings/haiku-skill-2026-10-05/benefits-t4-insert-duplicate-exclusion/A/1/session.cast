row in enumerate(ws.iter_rows(min_row=1, max_row=ws.max_row), 1):                                             \u001b[39m\u001b[49m\r\r\n\u001b[6G\u001b[38;5;167m\u001b[48;5;52m 12 -\u001b[38;5;231m    cell_value = row[0].value                                                                                              \u001b[39m\u001b[49m\r\r\n\u001b[6G\u001b[38;5;167m\u001b[48;5;52m 13 -\u001b[38;5;231m    if cell_value and 'Gender' in str(cell_value) and 'U' in str(cell_value):                                              \u001b[39m\u001b[49m\r\r\n\u001b[6G\u001b[38;5;167m\u001b[48;5;52m 14 -\u001b[38;5;231m        target_row = row_idx                                                                                               \u001b[39m\u001b[49m\r\r\n\u001b[6G\u001b[38;5;167m\u001b[48;5;52m 15 -\u001b[38;5;231m        print(f\"Found 'Minus Gender=\\\"U\\\"' at row {target_row}\")                                                           \u001b[39m\u001b[49m\r\r\n\u001b[6G\u001b[38;5;167m\u001b[48;5;52m 16 -\u001b[38;5;231m        print(f\"Cell value: {cell_value}\")                                                                                 \u001b[39m\u001b[49m\r\r\n\u001b[6G\u001b[38;5;167m\u001b[48;5;52m 17 -\u001b[38;5;231m        break                                                                                                              \u001b[39m\u001b[49m\r\r\n\u001b[6G\u001b[38;5;74m\u001b[48;5;17m  7 +\u001b[38;5;242m# Insert a new row after row 28 (Minus Gender=\"U\")\u001b[38;5;231m                                                                         \u001b[39m\u001b[49m\r\r\n\u001b[6G\u001b[38;5;74m\u001b[48;5;17m  8 +\u001b[38;5;231mws.insert_rows(\u001b[38;5;141m29\u001b[38;5;231m, \u001b[38;5;141m1\u001b[38;5;231m)                                                                                                      \u001b[39m\u001b[49m\r\r\n\u001b[6G\u001b[38;5;231m\u001b[2m \u001b[8G9\u001b[10G\u001b[22m \u001b[39m\r\r\n\u001b[6G\u001