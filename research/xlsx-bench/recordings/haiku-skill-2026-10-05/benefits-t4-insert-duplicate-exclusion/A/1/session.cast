[32.080261, "o", "\u001b[38;5;231mws.cell(row=\u001b[38;5;141m29\u001b[38;5;231m, column=\u001b[38;5;141m3\u001b[38;5;231m).value = -\u001b[38;5;141m50\u001b[38;5;231m                                                                                      \u001b[39m\u001b[49m\r\r\n\u001b[6G\u001b[38;5;231m\u001b[2m 13\u001b[10G\u001b[22m \u001b[39m\r\r\n\u001b[6G\u001b[38;5;167m\u001b[48;5;52m 23 -\u001b[38;5;231m    # Add the new line                                                                                                     \u001b[39m\u001b[49m\r\r\n\u001b[6G\u001b[38;5;167m\u001b[48;5;52m 24 -\u001b[38;5;231m    ws.cell(row=target_row + 1, column=1).value = 'Minus Duplicate Records'                                                \u001b[39m\u001b[49m\r\r\n\u001b[6G\u001b[38;5;167m\u001b[48;5;52m 25 -\u001b[38;5;231m    ws.cell(row=target_row + 1, column=2).value = -50                                                                      \u001b[39m\u001b[49m\r\r\n\u001b[6G\u001b[38;5;74m\u001b[48;5;17m 14 +\u001b[38;5;242m# Update the Final Count formula to include the new row\u001b[38;5;231m                                                                    \u001b[39m\u001b[49m\r\r\n\u001b[6G\u001b[38;5;74m\u001b[48;5;17m 15 +\u001b[38;5;242m# Old formula was =SUM(C25:C28), needs to be =SUM(C25:C29)\u001b[38;5;231m                                                                 \u001b[39m\u001b[49m\r\r\n\u001b[6G\u001b[38;5;74m\u001b[48;5;17m 16 +\u001b[38;5;231mws.cell(row=\u001b[38;5;141m\u001b[48;5;24m30\u001b[38;5;231m\u001b[48;5;17m, column=\u001b[38;5;141m\u001b[48;5;24m3\u001b[38;5;231m\u001b[48;5;17m).value = \u001b[38;5;186m\u001b[48;5;24m'=SUM(C25:C29)'\u001b[38;5;231m\u001b[48;5;17m                                                                          \u001b[49m\u001b[39m\r\r\n\u001b[6G\u001b[38;5;231m\u001b[2m 17\u001b[10G\u001b[22m \u001b[39m\r\r\n\u001b[6G\u001b[38;5;167m\u001b[48;5;52m 27 -\u001b[38;5;231m    print(f\"Inserted 'Minus Duplicate Records' at row {target_row + 1}\")                                                   \u001b[39m\u001b[49m\r\r\n\u001b[6G\u001b[38;5;74m\u001b[48;5;17m 18 +\u001b[38;5;148mprint\u001b[38;5;231m(\u001b[38;5;186m\"\u001b[48;5;24mAdded\u001b[48;5;17m 'Minus Duplicate Records' row\"\u001b[38;5;231m)                                                                               \u001b[39m\u001b[49m\r\r\n\u001b[6G\u001b[38;5;74m\u001b[48;5;17m 19 +\u001b[38;5;148mprint\u001b[38;5;231m(\u001b[38;5;186mf\"Updated Final Count formula to =SUM(C25:C29)\"\u001b[38;5;231m)                                                                     \u001b[39m\u001b[49m\r\r\n\u001b[6G\u001b[38;5;231m\u001b[2m 20\u001b[10G\u001b[22m \u001b[39m\r\r\n\u001b[6G\u001b[38;5;167m\u001b[48;5;52m 29 -\u001b[38;5;231m    # Save the workbook                                                                                                    \u001b[39m\u001b[49m\r\r\n\u001b[6G\u001b[38;5;167m\u001b[48;5;52m 30 -\u001b[38;5;231m    wb.save('/tmp/xlsxb-e2484712/benefits-contribution-calculator.xlsm')                                                   \u001b[39m\u001b[49m\r\r\n\u001b[6G\u001b[38;5;167m\u001b[48;5;52m 31 -\u001b[38;5;231m    print(\"File saved successfully\")                                                                                       \u001b[39m\u001b[49m\r\r\n\u001b[6G\u001b[38;5;167m\u001b[48;5;52m 32 -\u001b[38;5;231melse:                                                                                                                      \u001b[39m\u001b[49m\r\r\n\u001b[6G\u001b[38;5;167m\u001b[48;5;52m 33 -\u001b[38;5;231m    print(\"Could not find 'Minus Gender=\\\"U\\\"' row\")                                                                       \u001b[39m\u001b[49m\r\r\n\u001b[6G\u001b[38;5;74m\u001b[48;5;17m 21 +\u001b[38;5;242m# Save the workbook\u001b[38;5;231m                                                                                                        \u001b[