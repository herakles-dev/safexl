# Copy to .env and fill in what you need. The core CLI, MCP server and plugin need none of these.
# Nothing here is read from a .env file automatically: export the variables in your shell.

# --- Model-agnostic benchmark harness (research/xlsx-bench/agnostic/) ---
# API key for the paid OpenRouter backend (used when AGN_BACKEND=openrouter)
OPENROUTER_API_KEY=
# API key for the local OpenAI-compatible gateway (default backend, address set by GATEWAY in harness.py)
FREE_LLM_APP_KEY=
# Backend to use: "gateway" (default) or "openrouter"
AGN_BACKEND=
# Path to the safexl-mcp binary the harness launches (default: packages/safexl/.venv/bin/safexl-mcp)
AGN_MCP_BIN=
# Python used by agnostic/selftest.py (default: packages/safexl/.venv/bin/python)
AGN_PYTHON=
# Optional extra copy of the summary verdict JSON written by agnostic/summarize.py
AGN_SUMMARY_OUT=

# --- Claude Code benchmark runner (research/xlsx-bench/runner.py, record.py) ---
# Model for the clean-room runs (default: claude-opus-5-5)
XLSX_BENCH_MODEL=
# Set to 1 to run arm B with the plugin's hooks on
XLSX_BENCH_PLUGIN_HOOKS=
# Set to 1 to add the one-line operator hint to the prompt
XLSX_BENCH_OPERATOR_HINT=
# Use another copy of the plugin directory (default: packages/safexl/claude-plugin)
XLSX_BENCH_PLUGIN_DIR=
# Use another virtualenv bin directory for SafeXL (default: packages/safexl/.venv/bin)
XLSX_BENCH_SAFEXL_BIN=
# Parent directory for run temp dirs (default: /tmp)
XLSX_BENCH_TMP_ROOT=

# --- Claude Code plugin guard hook (packages/safexl/claude-plugin/hooks/guard_hook.py) ---
# Set to off, 0 or false to disable the guard hook
SAFEXL_GUARD=
# "restore" restores the original on damage; anything else (default) salvages
SAFEXL_GUARD_MODE=
# Path to the safexl binary (default: found on PATH)
SAFEXL_BIN=

# --- Tests ---
# Set to 1 to skip the performance tests in packages/safexl
SAFEXL_SKIP_PERF=
# Path to the safexl package for research/xlsx-bench/tests/test_no_task_leak.py (default: packages/safexl)
SAFEXL_PKG=

# Set by Claude Code, not by you: CLAUDE_PLUGIN_ROOT, CLAUDE_PLUGIN_DATA
